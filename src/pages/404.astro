---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="zh-CN" dir="ltr">
  <head>
    <BaseHead title="页面未找到 — HardStack" description="您访问的页面不存在或已被移动。请检查网址或返回首页浏览我们的开源项目教程。" />
  </head>
  <body>
    <Header />
    <main class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
      <h1 class="font-serif text-6xl font-light text-[var(--text-heading)]">404</h1>
      <p class="mt-4 text-lg text-[var(--text-muted)]">页面不存在</p>
      <a href="/" class="mt-8 inline-block rounded-lg bg-[var(--color-accent-ui)] px-6 py-2.5 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90">
        返回首页
      </a>
    </main>
    <Footer />
  </body>
</html>
